						</xs:annotation>
					</xs:element>
					<xs:element name="Email" type="tEmail" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Адрес электронной почты</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	
	<xs:complexType name="tWorkPersonNoSNILS">
		<xs:annotation>
