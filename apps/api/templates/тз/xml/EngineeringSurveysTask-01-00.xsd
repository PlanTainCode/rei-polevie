				<xs:sequence>
					<xs:element name="Position" type="tNotEmptyString" minOccurs="1" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Должность</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Email" type="tEmail" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Адрес электронной почты</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
				<xs:attribute name="FunctionalRole" type="tFunctionalRole" use="optional">
					<xs:annotation>
						<xs:documentation>Функциональная роль подписанта</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="tEngineerPersonNOPRIZ">
		<xs:annotation>
			<xs:documentation>Лицо, принимавшие участие в разработке проектной документации и/или отчета о результатах инженерных изысканий (обязательное включение в Национальный реестр специалистов НОПРИЗ)</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="tAbstractPerson">
				<xs:sequence>
					<xs:element name="SNILS" type="tSNILS" minOccurs="1" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Страховой номер индивидуального лицевого счёта</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="NOPRIZNumber" type="tNOPRIZPersonNumber" minOccurs="1" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Идентификационный номер в Национальном реестре специалистов НОПРИЗ</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="Email" type="tEmail" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Адрес электронной почты</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
				<xs:attribute name="role" type="tEngineerRole" use="required">
					<xs:annotation>
						<xs:documentation>Роль участника разработки, нормоконтроля или согласования документа - части проектной документации</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	
	<!-- Индивидуальный предприниматель -->
	<xs:complexType name="tIndividualEntrepreneur">
		<xs:annotation>
			<xs:documentation>Индивидуальный предприниматель</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="tAbstractPerson">
				<xs:sequence>
					<xs:element name="OGRNIP" type="tOGRNIP" minOccurs="1" maxOccurs="1">
