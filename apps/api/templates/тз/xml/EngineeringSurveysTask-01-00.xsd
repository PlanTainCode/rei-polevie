<?xml version="1.1" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" 
    xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" vc:minVersion="1.1">
	<!-- Основной элемент -->
	
    <!-- Корневой элемент -->
    
    <xs:element name="Document" type="tDocument">
        <xs:annotation>
            <xs:documentation>Документ: Задание на выполнение инженерных изысканий</xs:documentation>
        </xs:annotation>
    </xs:element>

    <!-- Описание типов -->

    <!-- Документ -->

    <xs:complexType name="tDocument">
        <xs:annotation>
            <xs:documentation>Документ</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="Requisites" type="tRequisites" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Реквизиты документа</xs:documentation>
                </xs:annotation>
            </xs:element>
			<xs:element name="Versions" type="tVersions" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Предыдущие версии документа</xs:documentation>
                </xs:annotation>
                <xs:unique name="VersionNumberUnique">
                    <xs:annotation>
                        <xs:documentation>Предыдущие версии документа: проверка уникальности предыдущих версий xml-документа по порядковому номеру</xs:documentation>
                    </xs:annotation>
                    <xs:selector xpath="Version"/>
                    <xs:field xpath="@VersionNumber"/>
                </xs:unique>
                <xs:unique name="VersionChecksumUnique">
                    <xs:annotation>
                        <xs:documentation>Предыдущие версии документа: проверка уникальности предыдущих версий xml-документа по хэш-сумме файла</xs:documentation>
                    </xs:annotation>
                    <xs:selector xpath="Version"/>
                    <xs:field xpath="@Checksum"/>
                </xs:unique>
            </xs:element>
            <xs:element name="Content" type="tContent" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Содержимое документа</xs:documentation>
                </xs:annotation>
            </xs:element>            
        </xs:sequence>
        <xs:attribute name="Id" type="tGUID" use="optional">
            <xs:annotation>
                <xs:documentation>Идентификатор документа</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="TypeCode" type="tDocumentsTypeCode" use="required" fixed="05.01">
            <xs:annotation>
                <xs:documentation>Код вида документа</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="VersionNumber" use="required">
            <xs:annotation>
                <xs:documentation>Номер версии документа</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:unsignedByte">
                    <xs:minInclusive value="1"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
    </xs:complexType>
    
    <!-- Реквизиты документа -->

    <xs:complexType name="tRequisites">
        <xs:annotation>
            <xs:documentation>Реквизиты документа</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="Date" type="xs:date" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Дата составления документа</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Number" type="tNotEmptyString" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Регистрационный номер документа (Шифр задания на инженерные изыскания)</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Authors" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Авторы документа - утверждающий документ</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Author" type="tAuthor"  minOccurs="1" maxOccurs="unbounded">
                            <xs:annotation>
                                <xs:documentation>Автор документа</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:sequence>
                    <xs:assert test="count(.//*[@FunctionalRole = 'Утверждено']) = 1">
                        <xs:annotation>
                            <xs:documentation>Проверка, что может быть указан только один утверждающий документа</xs:documentation>
                        </xs:annotation>
                    </xs:assert>
                </xs:complexType>
            </xs:element>
            <xs:element name="SecurityLabel" type="tSecurityLabel" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>Гриф ограничения доступа к документу</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    

   <!-- Содержимое документа -->

    <xs:complexType name="tContent">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Содержание задания на выполнение инженерных изысканий</xs:documentation>
		</xs:annotation>
			<xs:sequence>
				<xs:element name="ObjectInfo" type="tObjectInfo" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Сведения об объекте</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="SurveysInitiationDocuments" type="tDocumentsInfo" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Документы - основание для выполнения работ</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="ConstructionType" type="tConstructionType" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Вид градостроительной деятельности</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="EngineeringSurveyTimePeriod" type="tNotEmptyString" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Сведения о сроках выполнения работ по ИИ, проектирования и эксплуатации объекта</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:choice minOccurs="1" maxOccurs="unbounded">
					<xs:element name="Developer" type="tDevelopers">
						<xs:annotation>
							<xs:documentation xml:lang="ru">Сведения о застройщике</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="TechnicalCustomer" type="tTechnicalCustomer">
						<xs:annotation>
							<xs:documentation xml:lang="ru">Сведения о техническом заказчике</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:choice>
				<xs:element name="Researchers" type="tResearchers" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Сведения о лицах, заключивших договоры на выполнение инженерных изысканий</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Purposes" type="tPurposes" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Цели инженерных изысканий</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Tasks" type="tTasks" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Задачи инженерных изысканий</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="EngineeringSurveyStage" type="tEngineeringSurveyStage" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Этап выполнения инженерных изысканий</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="EngineeringSurveyTypes" type="tEngineeringSurveyTypes" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Виды необходимых инженерных изысканий</xs:documentation>
					</xs:annotation>
					<xs:unique name="BasicEngineeringSurveyTypeKey">
						<xs:annotation>
							<xs:documentation>Ключ для контроля повторения вида инженерных изысканий - основные виды инженерных изысканий</xs:documentation>
						</xs:annotation>
						<xs:selector xpath="BasicEngineeringSurvey/BasicEngineeringSurveyType"/>
						<xs:field xpath="."/>
					</xs:unique>
					<xs:unique name="SpecialEngineeringSurveyTypeKey">
						<xs:annotation>
							<xs:documentation>Ключ для контроля повторения вида инженерных изысканий - специальные виды инженерных изысканий</xs:documentation>
						</xs:annotation>
						<xs:selector xpath="SpecialEngineeringSurvey/SpecialEngineeringSurveyType"/>
						<xs:field xpath="."/>
					</xs:unique>
				</xs:element>
				<xs:element name="TechnogenicImpacts" type="tTextBlock" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Предполагаемые техногенные воздействия объекта на окружающую среду</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Ecology" type="tEcology" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Описание экологической обстановки</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="BoundariesArealLinear" type="tBoundariesArealLinear" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Данные о границах площадки (площадок) и (или) трассы (трасс) линейного сооружения (точки ее начала и окончания, протяженность)</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="DangerousNaturalProcesses" type="tDangerousNaturalProcessesSoils" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Наличие предполагаемых опасных природных процессов и явлений, многолетнемерзлых и специфических грунтов на территории расположения объекта</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Requirements" type="tRequirements" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Требования к выполнению изысканий</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="AvailableDocuments" type="tDocumentsInfo" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Документы, прилагаемые к заданию на проведение инженерных изысканий</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="SchemaVersion" type="tSchemaVersion" use="required" fixed="01.00">
                <xs:annotation>
                    <xs:documentation xml:lang="ru">Номер версии схемы, используемой при создании задания на выполнение инженерных изысканий</xs:documentation>
                </xs:annotation>
            </xs:attribute>
	</xs:complexType>
	<!-- Конец описания основного элемента -->

	<!-- Описание сложных типов -->

    <xs:complexType name="tVersions">
        <xs:annotation>
            <xs:documentation>Сведения о предыдущих версиях документа</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="Version" type="tVersion" minOccurs="1" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>Сведения о предыдущей версии документа</xs:documentation>
                </xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	
    <xs:complexType name="tVersion">
	    <xs:annotation>
            <xs:documentation>Сведения о предыдущей версии документа</xs:documentation>
        </xs:annotation>
			<xs:sequence>
					<xs:element name="Modification" type="tNotEmptyString" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation xml:lang="ru">Сведения о внесенных изменениях в задания на выполнение инженерные изыскания</xs:documentation>
						</xs:annotation>
					</xs:element>
        </xs:sequence>
    	<xs:attribute name="VersionNumber" use="required">
    		<xs:annotation>
    			<xs:documentation>Номер версии из предыдущей версии документа (указанный в Document/@VersionNumber)</xs:documentation>
    		</xs:annotation>    
    		<xs:simpleType>
    			<xs:restriction base="xs:int">
    				<xs:minInclusive value="1"/>
    			</xs:restriction>
    		</xs:simpleType>
    	</xs:attribute>
    	<xs:attribute name="Id" type="tGUID" use="required">
    		<xs:annotation>
    			<xs:documentation>Идентификатор документа из предыдущей версии документа (указан в Document/@Id)</xs:documentation>
    		</xs:annotation>    
    	</xs:attribute>
    	<xs:attribute name="Date" type="xs:date" use="required">
    		<xs:annotation>
    			<xs:documentation>Дата разработки из предыдущей версии документа (указнная в реквизитной части Requisites/Date)</xs:documentation>
    		</xs:annotation>    
    	</xs:attribute>
    	<xs:attribute name="Number" type="tNotEmptyString" use="required">
    		<xs:annotation>
    			<xs:documentation>Номер документа из предыдущей версии документа (указан в реквизитной части Requisites/Number)</xs:documentation>
    		</xs:annotation>    
    	</xs:attribute>
    	<xs:attribute name="Checksum" type="tFileChecksum" use="required">
    		<xs:annotation>
    			<xs:documentation>Контрольная сумма файла из предыдущей версии документа (по алгоритму CRC32-IEEE)</xs:documentation>
    		</xs:annotation>
    	</xs:attribute>
    	<xs:attribute name="SchemaVersion" type="tSchemaVersion" use="required">
    		<xs:annotation>
    			<xs:documentation>Номер версии XML-схемы, использованной при формировании версии документа</xs:documentation>
    		</xs:annotation>
    	</xs:attribute>
    </xs:complexType>
	
	

    <xs:complexType name="tAuthor">
        <xs:annotation>
            <xs:documentation>Автор документа</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:choice>
                <xs:sequence>
                    <xs:element name="Organization" type="tOrganizationNOPRIZ" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                            <xs:documentation>Юридическое лицо</xs:documentation>
                        </xs:annotation>
                    </xs:element>
                    <xs:element name="Representatives" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                            <xs:documentation>Представители организации, подписавшие документ</xs:documentation>
                        </xs:annotation>
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="Representative" type="tWorkPersonNoSNILS"  minOccurs="1" maxOccurs="unbounded">
                                    <xs:annotation>
                                        <xs:documentation>Представитель</xs:documentation>
                                    </xs:annotation>
                                </xs:element>
                            </xs:sequence>
                        </xs:complexType>
                    </xs:element>
                </xs:sequence>
                <xs:sequence>
                    <xs:choice>
                        <xs:element name="IndividualEntrepreneur" minOccurs="1" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>Индивидуальный предприниматель</xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                                <xs:complexContent>
                                    <xs:extension base="tIndividualEntrepreneurNOPRIZ">
                                        <xs:attribute name="FunctionalRole" type="tFunctionalRole" use="required">
                                            <xs:annotation>
                                                <xs:documentation>Функциональная роль подписанта</xs:documentation>
                                            </xs:annotation>
                                        </xs:attribute>                    
                                    </xs:extension>
                                </xs:complexContent>
                            </xs:complexType>
                        </xs:element>
                    </xs:choice>
                </xs:sequence>
            </xs:choice>
        </xs:sequence>
    </xs:complexType>
    
	<xs:complexType name="tPlacement">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Местоположение объекта</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Address" type="tObjectAddress" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Адрес объекта</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CadastralAreas" type="tCadastralAreas" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Кадастровые кварталы и/или участки</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Areas" type="tAreas" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Координаты участков</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="tCadastralAreas">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Кадастровые кварталы и/или участки</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CadastralDistrict" type="tCadastralDistrictNumber" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Номер кадастрового квартала</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CadastralSite" type="tCadastralSiteNumber" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Номер кадастрового участка</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="tAreas">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Координаты участков</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Area" type="tArea" minOccurs="1" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Координаты участка</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="tArea">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Координаты участка</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CoordinateAndHeightSystem" type="tCoordinateAndHeightSystems" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Системы координат и высот</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Point" type="tPoint" minOccurs="3" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Точка координат</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="Name" use="optional" type="tNotEmptyString">
			<xs:annotation>
				<xs:documentation xml:lang="ru">Номер, идентификатор или наименование участка</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		
	</xs:complexType>

	<xs:complexType name="tPoint">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Координатная точка</xs:documentation>
		</xs:annotation>
		<xs:simpleContent>
			<xs:extension base="xs:string">
				<xs:attribute name="CoordinateX" type="xs:decimal" use="required">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Координата X</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="CoordinateY" type="xs:decimal" use="required">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Координата Y</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>

	<xs:complexType name="tPurposes">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Цели инженерных изысканий</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Purpose" type="tNotEmptyString" minOccurs="1" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Цель</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="tTasks">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Задачи инженерных изысканий</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Task" type="tNotEmptyString" minOccurs="1" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation xml:lang="ru">Задача</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	
	<xs:complexType name="tObjectInfo">
		<xs:annotation>
			<xs:documentation>Сведения об объекте</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:choice>
				<xs:element name="ComplexObject" type="tComplexObject" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Сложный (составной) объект</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="OKS" type="tOKS" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Объект капитального строительства (простой объект)</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:choice>
			<xs:choice>
				<xs:element name="ArealObject" type="tArealObject" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Параметры основного площадного объекта</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="LinearObject" type="tLinearObject" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="ru">Параметры основного линейного объекта</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:choice>
		</xs:sequence>
	</xs:complexType>
	
	<xs:complexType name="tComplexObject">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Часть объекта - сложный объект</xs:documentation>
		</xs:annotation>
		<xs:sequence>
